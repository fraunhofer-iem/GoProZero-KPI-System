<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Sustainability KPI Field Guide — GoProZero</title>
<!--
  ============================================================================
  EDITING THIS FILE  ·  tools/templates/kpi_manual.html.template
  ============================================================================
  SUSTAINABILITY FIELD-GUIDE EDITION of the KPI-system visual manual — a
  hand-designed "botanical field guide" re-skin. This is a TEMPLATE: the build
  script injects the KPI catalog JSON into the single catalog-JSON marker (the
  empty script#catalog block near the bottom) and writes
  output/kpi-system-manual.html. Rebuild after any catalog edit:

      uv run tools/scripts/build_visualization.py \
          --template tools/templates/kpi_manual.html.template \
          --out output/kpi-system-manual.html

  It shares the SAME catalog and the SAME interactive JavaScript (explorer tree,
  detail panel, search, references, glossary, strategies, columns) as
  kpi_visualization.html.template — only DOMAIN_COLORS were retuned to the
  earthy palette. All visual identity (typography, atmosphere, layout, motion)
  is authored here. Like the sibling template, the authored prose sections
  MIRROR docs/USER_MANUAL.md by hand; changing the manual does not change this.
  ============================================================================
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,600&family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script>
  /* Arm scroll-reveal before first paint (avoids a flash of hidden content).
     Only when we can actually animate; otherwise content stays visible. */
  if('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    document.documentElement.classList.add('reveal-armed');
  }
</script>
<style>
  /* ============================================================ *
   *  DESIGN TOKENS — "field guide" palette: warm paper, forest    *
   *  ink, and five earthy domain hues drawn from a natural system *
   * ============================================================ */
  :root{
    --paper:#f4f0e6;         /* warm herbarium paper            */
    --paper2:#efe9db;        /* slightly deeper paper for bands */
    --panel:#fffdf7;         /* card / panel surface            */
    --ink:#1b2a20;           /* deep forest ink                 */
    --muted:#5f6d61;         /* faded ink                       */
    --line:#e3dccb;          /* hairline on paper               */
    --line-soft:#ece6d7;

    --accent:#2f7d4f;        /* leaf green                      */
    --accent-dark:#1e5b39;
    --accent-soft:#e7f0e6;
    --gold:#b0791f;          /* dried-grass gold accent         */

    /* level ramp: canopy → understorey → forest floor */
    --l1:#1e5b39; --l2:#2f7d4f; --l3:#4f9c6b; --l4:#8fc3a0; --l5:#9aa19a;
    --l1bg:#e6eee7; --l2bg:#ebf2ec; --l3bg:#eef5ef; --l4bg:#f3f8f2; --l5bg:#f1f1ee;

    --warn:#a9691a; --warnbg:#f7edd8;

    --shadow:0 1px 2px rgba(27,42,32,.05),0 10px 30px rgba(27,42,32,.07);
    --shadow-lg:0 18px 46px rgba(27,42,32,.14);
    --radius:16px;

    --display:"Fraunces",Georgia,"Times New Roman",serif;
    --sans:"Hanken Grotesk",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;color:var(--ink);font-family:var(--sans);line-height:1.6;font-size:16px;
    background:var(--paper);
    /* atmosphere: soft canopy light + a faint contour-line topography */
    background-image:
      radial-gradient(1100px 520px at 88% -6%, rgba(143,195,160,.28) 0, transparent 62%),
      radial-gradient(760px 420px at -4% 4%, rgba(176,121,31,.13) 0, transparent 58%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'><g fill='none' stroke='%231b2a20' stroke-opacity='0.035' stroke-width='1'><path d='M0 60 Q30 40 60 60 T120 60'/><path d='M0 80 Q30 60 60 80 T120 80'/><path d='M0 40 Q30 20 60 40 T120 40'/><path d='M0 100 Q30 80 60 100 T120 100'/><path d='M0 20 Q30 0 60 20 T120 20'/></g></svg>");
    background-attachment:fixed,fixed,scroll;
  }
  a{color:var(--accent-dark);text-decoration:none}
  a:hover{text-decoration:underline}
  code,.mono{font-family:var(--mono);font-size:.85em}
  h2{font-family:var(--display);font-weight:600;font-size:clamp(1.7rem,3.3vw,2.5rem);line-height:1.08;letter-spacing:-.015em;margin:.15em 0 .12em}
  h3{font-family:var(--display);font-weight:600;font-size:1.22rem;margin:1.5em 0 .45em;letter-spacing:-.01em}
  .wrap{max-width:1180px;margin:0 auto;padding:0 26px}
  .kicker{
    text-transform:uppercase;letter-spacing:.18em;font-size:.7rem;font-weight:700;color:var(--accent-dark);
    display:inline-flex;align-items:center;gap:9px;
  }
  .kicker::before{content:"";width:22px;height:1px;background:var(--gold);display:inline-block}

  /* ---------------- nav ---------------- */
  nav{position:sticky;top:0;z-index:50;background:rgba(244,240,230,.86);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
  nav .wrap{display:flex;align-items:center;gap:18px;height:60px}
  nav .brand{font-family:var(--display);font-weight:700;font-size:1.05rem;letter-spacing:-.01em;display:flex;align-items:center;gap:11px;white-space:nowrap}
  nav .dot{width:20px;height:20px;flex-shrink:0}
  nav .links{display:flex;gap:2px;margin-left:auto;flex-wrap:wrap}
  nav .links a{color:var(--muted);font-size:.84rem;font-weight:600;padding:6px 11px;border-radius:9px;transition:background .15s,color .15s}
  nav .links a:hover{background:var(--accent-soft);color:var(--accent-dark);text-decoration:none}

  /* ---------------- hero ---------------- */
  header.hero{padding:78px 0 52px;position:relative;overflow:hidden}
  .hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:40px;align-items:center}
  @media(max-width:860px){.hero-grid{grid-template-columns:1fr}.hero-art{display:none}}
  header.hero .tag-guide{
    font-family:var(--mono);font-size:.74rem;letter-spacing:.02em;color:var(--gold);font-weight:600;
    display:inline-block;margin-bottom:14px;
  }
  header.hero h1{
    font-family:var(--display);font-weight:600;font-size:clamp(2.3rem,5.2vw,4rem);line-height:1.02;
    letter-spacing:-.028em;margin:.1em 0 .4em;
  }
  header.hero h1 em{font-style:italic;font-weight:500;color:var(--accent-dark)}
  header.hero p.lead{font-size:1.16rem;color:#3a4740;margin:0 0 30px;max-width:44ch}
  header.hero p.lead b{color:var(--accent-dark);font-weight:700}
  .meta-pills{display:flex;gap:11px;flex-wrap:wrap}
  .pill{
    background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:9px 16px;
    font-size:.82rem;font-weight:600;box-shadow:var(--shadow);display:flex;align-items:baseline;gap:8px;
  }
  .pill b{font-family:var(--display);color:var(--accent-dark);font-size:1.25rem;font-weight:700;line-height:1}

  /* hero decorative "growth rings" — composite built from five domains */
  .hero-art{display:flex;justify-content:center}
  .hero-art svg{width:100%;max-width:320px;height:auto;filter:drop-shadow(0 14px 30px rgba(27,42,32,.14))}

  /* ---------------- sections ---------------- */
  section{padding:56px 0;border-top:1px solid var(--line)}
  section > .wrap > p{color:#33413a}
  /* section intros span the full content width (like the original), so they
     don't stop mid-page — only the hero lead is narrowed for the graphic. */
  .lede{font-size:1.08rem}

  /* reveal on scroll — progressive enhancement: content is visible by
     default and only hidden once JS confirms it can animate (.reveal-armed
     is set on <html> by an early inline script). No JS / reduced-motion /
     print => everything stays visible. */
  .reveal{transition:opacity .7s ease,transform .7s ease}
  .reveal-armed .reveal{opacity:0;transform:translateY(18px)}
  .reveal-armed .reveal.in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){
    .reveal,.reveal-armed .reveal{opacity:1;transform:none;transition:none}
    html{scroll-behavior:auto}
  }
  @media print{
    .reveal,.reveal-armed .reveal{opacity:1!important;transform:none!important}
  }

  /* ---------------- big picture ---------------- */
  .bigpic{display:flex;flex-direction:column;align-items:center;gap:0;margin:34px 0 6px}
  .crown{
    position:relative;background:radial-gradient(120% 120% at 50% 0%,#2f7d4f 0,#1e5b39 70%,#164429 100%);
    color:#fff;border-radius:18px;padding:20px 34px;text-align:center;box-shadow:var(--shadow-lg);min-width:300px;
  }
  .crown::after{content:"";position:absolute;inset:0;border-radius:18px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}
  .crown .t{font-family:var(--display);font-size:1.5rem;font-weight:700;letter-spacing:-.01em}
  .crown .s{opacity:.82;font-size:.84rem;margin-top:2px}
  .connector{width:2px;height:34px;background:linear-gradient(var(--l2),var(--l4))}
  .fan{display:grid;grid-template-columns:repeat(5,1fr);gap:15px;width:100%}
  @media(max-width:780px){.fan{grid-template-columns:repeat(2,1fr)}}
  .domcard{
    border:1px solid var(--line);border-radius:14px;padding:16px;background:var(--panel);box-shadow:var(--shadow);
    border-top:4px solid var(--dc);transition:transform .18s,box-shadow .18s;position:relative;
  }
  .domcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .domcard .code{font-family:var(--mono);font-size:.72rem;color:#fff;background:var(--dc);padding:2px 9px;border-radius:6px;font-weight:600;display:inline-block}
  .domcard .nm{font-family:var(--display);font-weight:600;margin:10px 0 4px;font-size:1.02rem;line-height:1.15}
  .domcard .ds{font-size:.82rem;color:var(--muted);line-height:1.4}
  .flow-note{
    margin:26px auto 0;background:var(--accent-soft);border:1px solid #cfe1cf;border-radius:14px;
    padding:16px 20px;font-size:.95rem;max-width:780px;text-align:center;
  }
  .flow-note b{color:var(--accent-dark)}

  /* ---------------- generic grid + cards ---------------- */
  .grid{display:grid;gap:18px}
  .g2{grid-template-columns:repeat(2,1fr)}
  .g3{grid-template-columns:repeat(3,1fr)}
  @media(max-width:820px){.g2,.g3{grid-template-columns:1fr}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
  .card h4{font-family:var(--display);font-weight:600;margin:0 0 7px;font-size:1.06rem}
  .card .tag{font-family:var(--mono);font-size:.72rem;background:var(--accent-soft);color:var(--accent-dark);padding:4px 9px;border-radius:7px;font-weight:600;display:inline-block;margin-bottom:9px}
  .card p{margin:0;font-size:.9rem;color:#3a473f}

  /* ---------------- level legend ---------------- */
  .levels{display:flex;flex-direction:column;gap:9px;margin-top:10px}
  .lvl{display:flex;align-items:center;gap:16px;border:1px solid var(--line);border-radius:12px;padding:12px 16px;background:var(--panel);box-shadow:var(--shadow)}
  .lvl .chip{width:46px;height:46px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--display);font-weight:700;flex-shrink:0;font-size:1rem}
  .lvl .ttl{font-weight:700}
  .lvl .ex{font-family:var(--mono);font-size:.78rem;color:var(--muted);margin-left:auto;text-align:right}

  /* ---------------- explorer ---------------- */
  .explorer{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-lg);overflow:hidden}
  .ex-top{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line);background:linear-gradient(var(--paper2),var(--panel))}
  .domtabs{display:flex;gap:7px;flex-wrap:wrap}
  .domtab{border:1px solid var(--line);background:#fff;border-radius:10px;padding:8px 13px;font-weight:700;font-size:.83rem;cursor:pointer;color:var(--muted);display:flex;align-items:center;gap:8px;transition:all .15s}
  .domtab .b{width:11px;height:11px;border-radius:4px;background:var(--dc)}
  .domtab[aria-selected="true"]{color:#fff;background:var(--dc);border-color:var(--dc);box-shadow:var(--shadow)}
  .domtab[aria-selected="true"] .b{background:rgba(255,255,255,.9)}
  .ex-search{margin-left:auto;display:flex;gap:8px;align-items:center}
  .ex-search input{border:1px solid var(--line);border-radius:10px;padding:9px 13px;font-size:.88rem;width:240px;font-family:var(--sans);background:#fff}
  .ex-search input:focus{outline:2px solid var(--accent-soft);border-color:var(--accent)}
  .ex-btn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;font-size:.8rem;font-weight:600;cursor:pointer;color:var(--muted);transition:all .15s}
  .ex-btn:hover{background:var(--accent-soft);color:var(--accent-dark)}
  .ex-body{display:grid;grid-template-columns:1.15fr .85fr;min-height:540px}
  @media(max-width:900px){.ex-body{grid-template-columns:1fr}}
  .treepane{padding:12px 6px 18px 14px;overflow:auto;max-height:660px;border-right:1px solid var(--line)}
  @media(max-width:900px){.treepane{max-height:440px;border-right:none;border-bottom:1px solid var(--line)}}

  .node{margin:1px 0}
  .node-row{display:flex;align-items:center;gap:8px;padding:6px 9px;border-radius:9px;cursor:pointer;border:1px solid transparent}
  .node-row:hover{background:#f0f5f0}
  .node-row.sel{background:var(--accent-soft);border-color:#bcd8c3}
  .twist{width:16px;height:16px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.7rem;transition:transform .12s;user-select:none}
  .twist.open{transform:rotate(90deg)}
  .twist.leaf{visibility:hidden}
  .lvlbadge{font-family:var(--mono);font-size:.65rem;font-weight:600;color:#fff;border-radius:5px;padding:2px 5px;flex-shrink:0;min-width:34px;text-align:center}
  .node-id{font-family:var(--mono);font-size:.77rem;color:var(--muted);flex-shrink:0}
  .node-name{font-size:.87rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .node-row.raw .node-name{color:#414b45}
  .mini{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:2px 7px;border-radius:999px;flex-shrink:0}
  .mini.data{background:#edeae0;color:#5c6357;border:1px solid #ddd7c8}
  .mini.shared{background:#f7edd8;color:#8f6415;border:1px solid #ecdcb6}
  .children{margin-left:19px;border-left:1px dashed #d4cdbc;padding-left:7px;display:none}
  .children.open{display:block}

  /* detail pane */
  .detail{padding:22px 24px;overflow:auto;max-height:660px}
  @media(max-width:900px){.detail{max-height:none}}
  .detail .empty{color:var(--muted);font-size:.94rem;display:flex;flex-direction:column;gap:10px;height:100%;justify-content:center;align-items:center;text-align:center}
  .d-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .d-id{font-family:var(--mono);font-weight:600;color:#fff;padding:4px 10px;border-radius:8px}
  .d-name{font-family:var(--display);font-size:1.4rem;font-weight:600;line-height:1.12;margin:10px 0 2px;letter-spacing:-.01em}
  .d-strat{display:inline-block;font-family:var(--mono);font-size:.73rem;background:#efece2;border:1px solid var(--line);border-radius:8px;padding:3px 9px;font-weight:500;margin-top:7px}
  .d-desc{margin:14px 0;color:#33413a;font-size:.96rem}
  .kv{display:grid;grid-template-columns:auto 1fr;gap:7px 18px;margin:12px 0;font-size:.88rem}
  .kv dt{color:var(--muted);font-weight:600}
  .kv dd{margin:0}
  .chips{display:flex;flex-wrap:wrap;gap:7px}
  .refchip,.idchip,.stagechip{font-family:var(--mono);font-size:.73rem;border-radius:7px;padding:3px 8px;font-weight:500;cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--accent-dark)}
  .refchip:hover{background:var(--accent-soft)}
  .idchip{cursor:pointer;background:#f2f5f1}
  .idchip:hover{background:var(--accent-soft)}
  .stagechip{cursor:default;background:#eef1ec;color:#465049}
  .d-block{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
  .d-block .lbl{font-size:.71rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:700;margin-bottom:7px}
  .formula{font-family:var(--mono);font-size:.82rem;background:#f0f3ee;border:1px solid var(--line);border-radius:9px;padding:11px 13px;white-space:pre-wrap;word-break:break-word}
  .breadcrumb{font-size:.78rem;color:var(--muted);margin-bottom:5px;display:flex;flex-wrap:wrap;gap:5px;align-items:center}
  .breadcrumb .idchip{font-size:.7rem;padding:1px 6px}

  /* ---------------- tables ---------------- */
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);background:var(--panel)}
  table{border-collapse:collapse;width:100%;font-size:.88rem;min-width:520px}
  th,td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line-soft);vertical-align:top}
  th{background:var(--paper2);font-size:.71rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);position:sticky;top:0;font-weight:700}
  tbody tr:hover{background:#faf8f1}
  td code{background:#eef1ec;padding:1px 6px;border-radius:5px}

  details.fold{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:0;overflow:hidden}
  details.fold>summary{cursor:pointer;padding:17px 22px;font-weight:700;list-style:none;display:flex;align-items:center;gap:11px;font-family:var(--display);font-size:1.02rem}
  details.fold>summary::-webkit-details-marker{display:none}
  details.fold>summary::before{content:"❧";color:var(--accent);transition:transform .18s;font-size:1.1rem}
  details.fold[open]>summary::before{transform:rotate(90deg)}
  details.fold .inner{padding:0 22px 20px}

  .callout{border-left:4px solid var(--warn);background:var(--warnbg);border-radius:0 12px 12px 0;padding:15px 19px;margin:18px 0;font-size:.92rem}
  .callout b{color:#8a5613}
  .callout.info{border-color:var(--accent);background:var(--accent-soft)}
  .callout.info b{color:var(--accent-dark)}

  /* steps */
  ol.steps{list-style:none;counter-reset:s;padding:0;margin:18px 0 0;display:grid;gap:13px}
  ol.steps li{counter-increment:s;position:relative;padding:16px 18px 16px 62px;background:var(--panel);border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow)}
  ol.steps li::before{content:counter(s);position:absolute;left:15px;top:15px;width:32px;height:32px;border-radius:50%;background:radial-gradient(120% 120% at 50% 0%,#2f7d4f,#1e5b39);color:#fff;font-family:var(--display);font-weight:700;display:flex;align-items:center;justify-content:center;font-size:.95rem}
  ol.steps li b{display:block;margin-bottom:3px;font-size:1rem}
  ol.steps li span{font-size:.9rem;color:#3a473f}

  /* normalization viz */
  .normbox{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:720px){.normbox{grid-template-columns:1fr}}
  .band{border:1px solid var(--line);border-radius:13px;padding:17px;background:var(--panel);box-shadow:var(--shadow)}
  .band h4{font-family:var(--display);font-weight:600;margin:0 0 4px;font-size:1.02rem}
  .gradient{height:18px;border-radius:9px;margin:14px 0 6px}
  .gradient.up{background:linear-gradient(90deg,#c15a4e,#d1a01f,#2f8a53)}
  .gradient.down{background:linear-gradient(90deg,#2f8a53,#d1a01f,#c15a4e)}
  .bandlbl{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);font-family:var(--mono)}

  footer{padding:44px 0 72px;border-top:1px solid var(--line);color:var(--muted);font-size:.86rem}
  footer .leaf{color:var(--accent);font-size:1.1rem}

  #toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:#16241c;color:#fff;padding:15px 19px;border-radius:14px;max-width:min(560px,92vw);box-shadow:0 14px 44px rgba(0,0,0,.32);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:100;font-size:.9rem}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  #toast .tt{font-family:var(--mono);font-weight:600;color:#9be3b8;margin-bottom:4px}
  #toast .ty{font-size:.72rem;color:#9fb2a7;text-transform:uppercase;letter-spacing:.05em;margin-top:7px}
  #toast a{color:#9be3b8}
</style>
</head>
<body>
<nav>
  <div class="wrap">
    <span class="brand">
      <svg class="dot" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 22C12 22 4 17 4 10.5C4 6.9 6.9 4 10.5 4C11.9 4 13.2 4.6 12 6C12 6 12 2 16 2C16 6 12 6 12 6C13.2 4.6 20 6 20 12.5C20 18 12 22 12 22Z" fill="#2f7d4f"/>
        <path d="M12 22V8" stroke="#1e5b39" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      GoProZero KPI System
    </span>
    <span class="links">
      <a href="#picture">Big picture</a>
      <a href="#explorer">Explorer</a>
      <a href="#levels">Levels</a>
      <a href="#aggregation">Aggregation</a>
      <a href="#strategies">Strategies</a>
      <a href="#weights">Weights</a>
      <a href="#workflow">Workflow</a>
