  'gl.method':{en:'<p style="margin-bottom:8px"><b>Normalized</b>: min-max scaling onto 0–1. Whichever bound is larger sets the direction.</p><p style="margin-bottom:8px"><b>Inflow / Outflow</b>: quantity entering or leaving the process scope.</p><p style="margin-bottom:8px"><b>LCA</b>: Life Cycle Assessment, a common data source (OpenLCA, GaBi).</p><p><b>LCC</b>: Life Cycle Costing, the data source for monetary data.</p>',de:'<p style="margin-bottom:8px"><b>Normalisiert</b> — Min-Max-Skalierung auf 0–1; die Richtung ergibt sich daraus, welche Grenze größer ist.</p><p style="margin-bottom:8px"><b>Zufluss / Abfluss</b> — Menge, die in den Prozessumfang eintritt / ihn verlässt.</p><p style="margin-bottom:8px"><b>LCA</b> — Ökobilanz (Life Cycle Assessment); eine häufige Datenquelle (OpenLCA, GaBi).</p><p><b>LCC</b> — Lebenszykluskosten (Life Cycle Costing); die Datenquelle für monetäre Daten.</p>'},
  'gl.h3std':{en:'Standards &amp; frameworks<span style="font-weight:400;color:var(--muted);font-size:.9rem">: the bibliography behind the KPIs (search to filter)</span>',de:'Normen &amp; Rahmenwerke <span style="font-weight:400;color:var(--muted);font-size:.9rem">— das Quellenverzeichnis hinter den Kennzahlen (zum Filtern tippen)</span>'},
