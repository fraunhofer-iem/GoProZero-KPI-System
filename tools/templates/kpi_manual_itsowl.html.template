  'w.down.sub':{en:'intensity, time, cost',de:'Intensität, Zeit, Kosten'},
  'w.down.note':{en:'<b>Invert:</b> set Min &gt; Max',de:'<b>Umkehren:</b> Min &gt; Max setzen'},
