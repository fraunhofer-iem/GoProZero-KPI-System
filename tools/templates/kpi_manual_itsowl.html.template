/* ================= EXPLORER ================= */
const tabs=$('#domtabs'), treeEl=$('#tree'), detailEl=$('#detail');
let currentDomain='EN';

function renderTabs(){
  tabs.innerHTML=DOMAINS.map(d=>`<button class="domtab" role="tab" data-d="${d.id}" style="--dc:${DOMAIN_COLORS[d.id]}" aria-selected="${d.id===currentDomain}"><span class="b"></span>${esc(domName(d))}</button>`).join('');
}
tabs.addEventListener('click',e=>{const b=e.target.closest('.domtab');if(!b)return;currentDomain=b.dataset.d;tabs.querySelectorAll('.domtab').forEach(t=>t.setAttribute('aria-selected',t===b));renderTree();});

function buildNode(id,path){
  const k=KPIS[id]; if(!k) return null;
  if(path.includes(id)) return null;
  const node=el('div','node');
  const row=el('div','node-row'+(k.isRawDataPoint?' raw':''));
  row.dataset.id=id;
  const kids=(k.underlying||[]).filter(c=>KPIS[c]&&!KPIS[c].archived);
  const hasKids=kids.length>0;
  const twist=el('span','twist'+(hasKids?'':' leaf'),hasKids?'▶':'');
  const badge=el('span','lvlbadge','L'+k.level);badge.style.background=levelColor(k.domain,k.level);
  const idEl=el('span','node-id',esc(id));
  const nameEl=el('span','node-name',esc(k.name));
  row.append(twist,badge,idEl,nameEl);
  if(k.isRawDataPoint) row.append(el('span','mini data',u('chipData')));
  if((k.parents||[]).filter(p=>KPIS[p]).length>1) row.append(el('span','mini shared',u('chipShared')));
  node.append(row);
  let childWrap=null;
  if(hasKids){
    childWrap=el('div','children');
    const newPath=path.concat(id);
    kids.forEach(c=>{const cn=buildNode(c,newPath);if(cn)childWrap.append(cn);});
    node.append(childWrap);
    const toggle=(open)=>{
      const willOpen = open!=null?open:!childWrap.classList.contains('open');
      childWrap.classList.toggle('open',willOpen);
      twist.classList.toggle('open',willOpen);
    };
    twist.addEventListener('click',ev=>{ev.stopPropagation();toggle();});
    row.addEventListener('dblclick',()=>toggle());
  }
  row.addEventListener('click',()=>{selectNode(id,row);});
  node._toggle=childWrap?(o)=>{childWrap.classList.toggle('open',o);twist.classList.toggle('open',o);}:null;
  return node;
}

function renderTree(){
  treeEl.innerHTML='';
  const root=DOMAINS.find(d=>d.id===currentDomain).scoreId;
  const tree=buildNode(root,[]);
  treeEl.append(tree);
  if(tree._toggle) tree._toggle(true);
  tree.querySelectorAll(':scope > .children > .node').forEach(n=>{if(n._toggle)n._toggle(true);});
  // keep the current selection highlighted after a rebuild
  if(selectedId){const r=treeEl.querySelector(`.node-row[data-id="${CSS.escape(selectedId)}"]`);if(r)r.classList.add('sel');}
}

function setAll(open){
  treeEl.querySelectorAll('.children').forEach(c=>c.classList.toggle('open',open));
  treeEl.querySelectorAll('.twist').forEach(t=>{if(!t.classList.contains('leaf'))t.classList.toggle('open',open);});
}
$('#expandAll').addEventListener('click',()=>setAll(true));
$('#collapseAll').addEventListener('click',()=>setAll(false));

function selectNode(id,rowEl){
  treeEl.querySelectorAll('.node-row.sel').forEach(r=>r.classList.remove('sel'));
  if(rowEl) rowEl.classList.add('sel');
  renderDetail(id);
}

function refChip(label){
  const r=REFS[label];
  return `<span class="refchip" data-ref="${esc(label)}" title="${r?esc(r.title||label):''}">${esc(label)}</span>`;
}
function idChip(id){
  const k=KPIS[id];
  if(!k) return `<span class="idchip" style="cursor:default">${esc(id)}</span>`;
  return `<span class="idchip" data-goto="${esc(id)}" title="${esc(k.name)}">${esc(id)}</span>`;
}

function emptyDetailHTML(){
  return `<div class="empty"><div style="font-size:2rem;color:var(--teal)">◆</div><div>${u('emptyText')}</div></div>`;
}

function renderDetail(id){
  const k=KPIS[id]; if(!k)return;
  selectedId=id;
  const col=levelColor(k.domain,k.level);
  const stratName=((STRAT_INFO[LANG]||STRAT_INFO.en)[k.calculationStrategy]||[k.calculationStrategy])[0];
  let h=`<div class="breadcrumb">`+buildCrumb(id).map(idChip).join('<span style="color:var(--muted)">›</span>')+`</div>`;
  h+=`<div class="d-head"><span class="d-id" style="background:${col}">${esc(id)}</span>`;
  h+=`<span class="lvlbadge" style="background:${col}">${u('dLevel')} ${k.level}</span>`;
  if(k.isRawDataPoint) h+=`<span class="mini data">${u('dRawPoint')}</span>`;
  h+=`</div>`;
  h+=`<div class="d-name">${esc(k.name)}</div>`;
  h+=`<span class="d-strat" title="${u('dStrat')}">${esc(stratName)}</span>`;
  if(k.description) h+=`<p class="d-desc">${esc(k.description)}</p>`;

  const kv=[];
  if(k.objective) kv.push([u('dObjective'),esc(k.objective)]);
  if(k.unit) kv.push([u('dUnit'),`<code>${esc(k.unit)}</code>`]);
  if(k.dataSource) kv.push([u('dDataSource'),`<code>${esc(k.dataSource)}</code>`]);
  if(k.lifecycleStages&&k.lifecycleStages.length) kv.push([u('dLifecycle'),`<span class="chips">${k.lifecycleStages.map(s=>`<span class="stagechip">${esc(s)}</span>`).join('')}</span>`]);
  if(k.potentialReferenceValues) kv.push([u('dRefValues'),esc(k.potentialReferenceValues)]);
  if(k.exampleValue) kv.push([u('dExample'),esc(k.exampleValue)]);
  if(kv.length) h+=`<dl class="kv">`+kv.map(p=>`<dt>${p[0]}</dt><dd>${p[1]}</dd>`).join('')+`</dl>`;

  if(k.formula){h+=`<div class="d-block"><div class="lbl">${u('dFormula')}</div><div class="formula">${esc(k.formula)}</div></div>`;}

  const under=(k.underlying||[]).filter(c=>KPIS[c]);
  if(under.length){h+=`<div class="d-block"><div class="lbl">${u('dUnderlying').replace('{n}',under.length)}</div><div class="chips">${under.map(idChip).join('')}</div></div>`;}
  const par=(k.parents||[]).filter(c=>KPIS[c]);
  if(par.length){h+=`<div class="d-block"><div class="lbl">${u('dParents')}${par.length>1?' '+u('dParentsShared').replace('{n}',par.length):''}</div><div class="chips">${par.map(idChip).join('')}</div></div>`;}

  if(k.references&&k.references.length){h+=`<div class="d-block"><div class="lbl">${u('dRefs')}</div><div class="chips">${k.references.map(refChip).join('')}</div></div>`;}
  if(k.comment){h+=`<div class="d-block"><div class="lbl">${u('dComment')}</div><p style="margin:0;font-size:.88rem;color:var(--text)">${esc(k.comment)}</p></div>`;}

  detailEl.innerHTML=h;
  detailEl.scrollTop=0;
  detailEl.querySelectorAll('[data-ref]').forEach(c=>c.addEventListener('click',()=>showRef(c.dataset.ref)));
  detailEl.querySelectorAll('[data-goto]').forEach(c=>c.addEventListener('click',()=>gotoId(c.dataset.goto)));
}

function buildCrumb(id){
  const chain=[id]; let cur=id, guard=0;
  while(guard++<12){
    const k=KPIS[cur]; if(!k||!k.parents||!k.parents.length)break;
    const p=k.parents.find(x=>KPIS[x]); if(!p||chain.includes(p))break;
    chain.unshift(p); cur=p;
  }
  return chain;
}

function showRef(label){
  const r=REFS[label]; const t=$('#toast');
  if(!r){t.innerHTML=`<div class="tt">${esc(label)}</div><div>${u('toastNone')}</div>`;}
  else{
    const link=r.link?`<div style="margin-top:8px"><a href="${esc(r.link)}" target="_blank" rel="noopener">${u('toastOpen')}</a></div>`:'';
    t.innerHTML=`<div class="tt">${esc(label)}</div><div>${esc(r.description||r.title||'')}</div>${r.type?`<div class="ty">${esc(r.type)}</div>`:''}${link}`;
  }
  t.classList.add('show');
  clearTimeout(showRef._t); showRef._t=setTimeout(()=>t.classList.remove('show'),6000);
}
// The toast can hold a link, so hold it open while the pointer is on it. Without
// this the 6s timer can retract the toast out from under the click.
$('#toast').addEventListener('mouseenter',()=>clearTimeout(showRef._t));
$('#toast').addEventListener('mouseleave',()=>{
  clearTimeout(showRef._t);
  showRef._t=setTimeout(()=>$('#toast').classList.remove('show'),1500);
});

function gotoId(id){
  const k=KPIS[id]; if(!k)return;
  const dom=k.domain;
  if(dom!==currentDomain){
    currentDomain=dom;
    tabs.querySelectorAll('.domtab').forEach(t=>t.setAttribute('aria-selected',t.dataset.d===dom));
    renderTree();
  }
  const crumb=buildCrumb(id);
  for(const cid of crumb){
    const rows=[...treeEl.querySelectorAll(`.node-row[data-id="${CSS.escape(cid)}"]`)];
    rows.forEach(r=>{const wrap=r.parentElement.querySelector(':scope > .children');if(wrap){wrap.classList.add('open');const tw=r.querySelector('.twist');if(tw)tw.classList.add('open');}});
  }
  const target=treeEl.querySelector(`.node-row[data-id="${CSS.escape(id)}"]`);
  if(target){selectNode(id,target);target.scrollIntoView({block:'center',behavior:'smooth'});}
  else{renderDetail(id);}
  document.getElementById('explorer').scrollIntoView({behavior:'smooth',block:'start'});
}

/* ---------- search ---------- */
const searchInput=$('#search');
function updatePlaceholders(){
  searchInput.placeholder=u('searchPh').replace('{n}',Object.keys(ACTIVE).length);
  const rs=$('#refSearch'); if(rs) rs.placeholder=u('filterPh');
}
searchInput.addEventListener('input',e=>{
  const q=e.target.value.toLowerCase().trim();
  if(!q){renderTree();return;}
  const hits=Object.values(ACTIVE).filter(k=>k.id.toLowerCase().includes(q)||k.name.toLowerCase().includes(q)||(k.description||'').toLowerCase().includes(q)).slice(0,80);
  treeEl.innerHTML='';
  if(!hits.length){treeEl.append(el('div','',`<p style="padding:16px;color:var(--muted)">${u('searchNone').replace('{q}',esc(q))}</p>`));return;}
  const matches = LANG==='de' ? (hits.length+' Treffer') : (hits.length+' match'+(hits.length>1?'es':''));
  const head=el('div','',`<p style="padding:8px 10px;color:var(--muted);font-size:.82rem">${matches}${hits.length>=80?u('first80'):''}</p>`);
  treeEl.append(head);
  hits.forEach(k=>{
    const row=el('div','node-row'+(k.isRawDataPoint?' raw':''));
    row.dataset.id=k.id;
    const badge=el('span','lvlbadge','L'+k.level);badge.style.background=levelColor(k.domain,k.level);
    row.append(el('span','twist leaf'),badge,el('span','node-id',esc(k.id)),el('span','node-name',esc(k.name)+' '));
    const d=DOMAINS.find(x=>x.id===k.domain);
    const dc=el('span','mini',esc(domName(d)));dc.style.background=DOMAIN_COLORS[k.domain]+'22';dc.style.color=DOMAIN_COLORS[k.domain];
    row.append(dc);
    if(k.isRawDataPoint)row.append(el('span','mini data',u('chipData')));
    row.addEventListener('click',()=>selectNode(k.id,row));
    treeEl.append(el('div','node').appendChild(row).parentElement);
  });
});

/* ---------- generated line ---------- */
function updateGenline(){
  $('#genline').textContent=u('genline').replace('{src}',DATA.meta.source).replace('{n}',Object.keys(ACTIVE).length).replace('{m}',Object.keys(REFS).length);
}

/* ---------- language switch ---------- */
function updateLangButton(){
  const b=document.getElementById('langToggle'); if(!b)return;
  const other = LANG==='en' ? 'DE' : 'EN';
  b.textContent=other;
  b.setAttribute('aria-label', LANG==='en' ? 'Auf Deutsch umschalten' : 'Switch to English');
}
function setLang(l){
  LANG = (l==='de') ? 'de' : 'en';
  document.documentElement.setAttribute('lang',LANG);
  try{localStorage.setItem('kpi-lang',LANG);}catch(e){}
  applyProse();
  updatePlaceholders();
  renderPills(); renderFan(); renderLevels(); renderLadder(); renderStrategies(); renderGlossary(); renderColumns();
  renderTabs(); renderTree();
  if(selectedId && KPIS[selectedId]) renderDetail(selectedId); else detailEl.innerHTML=emptyDetailHTML();
  updateGenline(); updateLangButton();
}
(function(){var b=document.getElementById('langToggle');if(b)b.addEventListener('click',()=>setLang(LANG==='en'?'de':'en'));})();

/* ---------- init ---------- */
applyProse();
renderPills(); renderFan(); renderLevels(); renderLadder(); renderStrategies(); renderGlossary(); renderRefs(); renderColumns();
$('#refSearch').addEventListener('input',e=>{
  const q=e.target.value.toLowerCase().trim();
  $('#refTable tbody').querySelectorAll('tr').forEach(tr=>{
    const hit=!q||tr.dataset.l.includes(q)||tr.dataset.d.includes(q);
    tr.style.display=hit?'':'none';
  });
});
renderTabs();
updatePlaceholders(); updateGenline(); updateLangButton();
detailEl.innerHTML=emptyDetailHTML();   // localized empty state on first load
renderTree();
</script>

<script>
/* scroll-reveal: fade sections in as they enter view (non-invasive, additive) */
(function(){
  var els=document.querySelectorAll('.reveal');
  if(!('IntersectionObserver' in window)||window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    els.forEach(function(e){e.classList.add('in');});return;
  }
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}});
  },{rootMargin:'0px 0px -8% 0px',threshold:.08});
  els.forEach(function(e){io.observe(e);});
})();
</script>

<script>
/* theme toggle — flips html[data-theme] and remembers the choice */
(function(){
  var btn=document.getElementById('themeToggle'); if(!btn) return;
  btn.addEventListener('click',function(){
    var cur=document.documentElement.getAttribute('data-theme')==='light'?'light':'dark';
    var next=cur==='light'?'dark':'light';
    document.documentElement.setAttribute('data-theme',next);
    try{localStorage.setItem('kpi-theme',next);}catch(e){}
  });
})();
</script>
</body>
</html>
