<script>
  /* Before first paint: (1) theme (saved → dark), (2) language (saved →
     browser → en), (3) arm scroll-reveal only when we can animate. Avoids a
     flash of the wrong theme/language/hidden content. */
  (function(){
    try{
      var t=localStorage.getItem('kpi-theme');
      if(t!=='light'&&t!=='dark') t='dark';
      document.documentElement.setAttribute('data-theme',t);
    }catch(e){ document.documentElement.setAttribute('data-theme','dark'); }
    try{
      var lg=localStorage.getItem('kpi-lang');
      if(lg!=='en'&&lg!=='de'){ var nl=(navigator.language||navigator.userLanguage||'en').toLowerCase(); lg=nl.indexOf('de')===0?'de':'en'; }
      document.documentElement.setAttribute('lang',lg);
    }catch(e){ document.documentElement.setAttribute('lang','en'); }
    try{
      if('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
        document.documentElement.classList.add('reveal-armed');
      }
    }catch(e){}
  })();
</script>
<style>
  /* ============================================================ *
   *  THEME TOKENS — it's OWL. Colours live in per-theme blocks;   *
   *  everything below references the variables so one toggle      *
   *  (html[data-theme=…]) reskins the whole page.                 *
   * ============================================================ */
  :root{
    --radius:14px;
    --display:"Archivo",Helvetica,Arial,sans-serif;
    --sans:"Barlow",Helvetica,Arial,sans-serif;
    --brandf:"Montserrat",Helvetica,Arial,sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
    --red:#e2001b;
    --teal-dim:#0e7f97;
    --l1:#0a5566; --l2:#0d7488; --l3:#12879d; --l4:#1f9cb0; --l5:#5f7280;
    --wordmark:#fff;
  }
  html[data-theme="dark"]{
    --bg:#0b1622; --bg2:#0f1d2b; --panel:#14273a; --panel2:#1a3145;
    --ink:#f3f7fa; --text:#bdcad5; --muted:#7f909e; --line:#243a4d; --line-soft:#1c3042;
    --red-bright:#ff5163; --red-soft:rgba(226,0,27,.16);
    --teal:#7ad3e6; --teal-soft:rgba(122,211,230,.12);
    --green:#0d9e5a; --crown-glow:rgba(13,158,90,.42);
    --warn:#e0a53a; --warnbg:rgba(224,165,58,.12);
    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 28px rgba(0,0,0,.32);
    --shadow-lg:0 22px 52px rgba(0,0,0,.5);
    --pill-bg:rgba(255,255,255,.04); --hover-bg:rgba(255,255,255,.04);
    --chip-bg:rgba(255,255,255,.06); --input-bg:#0b1826; --code-bg:#0b1826;
    --footer-bg:#081019; --art-line:#31536a;
    --wordmark:#fff;
  }
  html[data-theme="light"]{
    --bg:#ffffff; --bg2:#f3f5f7; --panel:#ffffff; --panel2:#eef2f5;
    --ink:#0d1b28; --text:#33414d; --muted:#5c6773; --line:#e2e6ea; --line-soft:#eef1f4;
    --red-bright:#c50019; --red-soft:#fdebed;
    --teal:#0e7f97; --teal-soft:rgba(14,127,151,.10);
    --green:#0b8f50; --crown-glow:rgba(11,143,80,.30);
    --warn:#b5790a; --warnbg:#fbf3e0;
    --shadow:0 1px 2px rgba(22,35,46,.06),0 6px 20px rgba(22,35,46,.08);
    --shadow-lg:0 18px 44px rgba(22,35,46,.16);
    --pill-bg:#f3f5f7; --hover-bg:#f3f5f7;
    --chip-bg:#eef2f5; --input-bg:#ffffff; --code-bg:#eef2f5;
    --footer-bg:#0d1b28; --art-line:#c9d2da;
    --wordmark:#0d1b28;
  }

  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;color:var(--text);font-family:var(--sans);line-height:1.6;font-size:16px;
    background:var(--bg);background-attachment:fixed;transition:background-color .3s ease,color .3s ease;
  }
  html[data-theme="dark"] body{background-image:
    radial-gradient(1200px 560px at 90% -8%, rgba(122,211,230,.10) 0, transparent 60%),
    radial-gradient(900px 420px at -6% 2%, rgba(226,0,27,.10) 0, transparent 58%);}
  html[data-theme="light"] body{background-image:
    radial-gradient(1200px 560px at 90% -8%, rgba(14,127,151,.08) 0, transparent 60%),
    radial-gradient(900px 420px at -6% 2%, rgba(226,0,27,.05) 0, transparent 58%);}
  a{color:var(--red-bright);text-decoration:none}
  a:hover{text-decoration:underline}
  code,.mono{font-family:var(--mono);font-size:.84em}
  h2{font-family:var(--display);font-weight:800;font-size:clamp(1.8rem,3.4vw,2.7rem);line-height:1.04;letter-spacing:-.02em;margin:.1em 0 .12em;color:var(--ink)}
  h3{font-family:var(--display);font-weight:700;font-size:1.24rem;margin:1.5em 0 .45em;letter-spacing:-.01em;color:var(--ink)}
  .wrap{max-width:1200px;margin:0 auto;padding:0 26px}
  .kicker{
    text-transform:uppercase;letter-spacing:.14em;font-size:.72rem;font-weight:700;color:var(--teal);
    display:inline-flex;align-items:center;gap:9px;
  }
  .kicker::before{content:"";width:24px;height:3px;background:var(--red);display:inline-block;border-radius:2px}

  /* ---------------- nav + recreated logo + toggles ---------------- */
  nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  nav .wrap{display:flex;align-items:center;gap:14px;height:74px}
  nav .links{display:flex;gap:2px;margin-left:auto;flex-wrap:wrap;background:var(--pill-bg);border:1px solid var(--line);border-radius:999px;padding:5px 6px}
  nav .links a{color:var(--text);font-size:.84rem;font-weight:600;padding:8px 13px;border-radius:999px;transition:background .15s,color .15s}
  nav .links a:hover{color:#fff;background:var(--red);text-decoration:none}

  .brand{display:inline-flex;align-items:center;gap:14px;white-space:nowrap;text-decoration:none}
  .brand .wordmark{font-family:var(--brandf);font-weight:800;font-size:1.5rem;letter-spacing:-.03em;color:var(--wordmark);line-height:1}
  .brand .divider{width:1px;height:30px;background:var(--line)}
  .brand .owl{display:flex;flex-direction:column;gap:2px;line-height:1}
  .brand .owl .pb{font-size:.6rem;font-weight:600;color:var(--muted);letter-spacing:.01em}
  .brand .owl .box{font-family:var(--brandf);font-weight:800;font-size:.86rem;color:#fff;background:var(--red);padding:2px 7px 3px;border-radius:3px;letter-spacing:-.01em}
  @media(max-width:720px){.brand .divider,.brand .owl{display:none}}

  .toggles{display:flex;align-items:center;gap:8px;flex-shrink:0}
  .lang-toggle{height:40px;min-width:44px;padding:0 13px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);background:var(--pill-bg);color:var(--text);border-radius:999px;cursor:pointer;transition:all .15s;font-family:var(--display);font-weight:700;font-size:.8rem;letter-spacing:.05em}
  .lang-toggle:hover{color:#fff;background:var(--red);border-color:var(--red)}
  .theme-toggle{width:40px;height:40px;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);background:var(--pill-bg);color:var(--text);border-radius:999px;cursor:pointer;transition:all .15s}
  .theme-toggle:hover{color:#fff;background:var(--red);border-color:var(--red)}
  .theme-toggle svg{width:18px;height:18px}
  .theme-toggle .sun{display:none}
  html[data-theme="dark"] .theme-toggle .sun{display:block}
  html[data-theme="dark"] .theme-toggle .moon{display:none}

  /* ---------------- hero ---------------- */
  header.hero{padding:78px 0 60px;position:relative;overflow:hidden}
  header.hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,var(--red),transparent 70%)}
  .hero-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:44px;align-items:center}
  @media(max-width:860px){.hero-grid{grid-template-columns:1fr}.hero-art{display:none}}
  header.hero h1{
    font-family:var(--display);font-weight:900;font-size:clamp(2.3rem,5.2vw,4rem);line-height:1.0;
    letter-spacing:-.03em;margin:.16em 0 .38em;color:var(--ink);
  }
  header.hero h1 span{color:var(--teal)}
  header.hero p.lead{font-size:1.18rem;color:var(--teal);margin:0 0 30px;max-width:48ch;font-weight:500}
  header.hero p.lead b{color:var(--ink);font-weight:700}
  .meta-pills{display:flex;gap:0;flex-wrap:wrap;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;width:fit-content;background:var(--panel);box-shadow:var(--shadow)}
  .pill{padding:13px 22px;font-size:.78rem;font-weight:600;color:var(--muted);display:flex;flex-direction:column;gap:2px;border-right:1px solid var(--line)}
  .pill:last-child{border-right:none}
  .pill b{font-family:var(--display);color:var(--ink);font-size:1.55rem;font-weight:800;line-height:1}

  .hero-art{display:flex;justify-content:center}
  .hero-art svg{width:100%;max-width:340px;height:auto;filter:drop-shadow(0 18px 36px rgba(0,0,0,.28))}

  /* ---------------- sections ---------------- */
  section{padding:62px 0;border-top:1px solid var(--line)}
  section:nth-of-type(even){background:var(--bg2)}
  section > .wrap > p{color:var(--text)}
  .lede{font-size:1.08rem;color:var(--teal);font-weight:500}

  /* reveal on scroll — progressive enhancement (visible without JS / print / reduced-motion) */
  .reveal{transition:opacity .6s ease,transform .6s ease}
  .reveal-armed .reveal{opacity:0;transform:translateY(16px)}
  .reveal-armed .reveal.in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){
    .reveal,.reveal-armed .reveal{opacity:1;transform:none;transition:none}
    html{scroll-behavior:auto}
  }
  @media print{ .reveal,.reveal-armed .reveal{opacity:1!important;transform:none!important} }

  /* ---------------- big picture ---------------- */
  .bigpic{display:flex;flex-direction:column;align-items:center;gap:0;margin:34px 0 6px}
  .crown{
    position:relative;background:var(--green);color:#fff;border-radius:var(--radius);
    padding:22px 38px;text-align:center;box-shadow:0 16px 40px var(--crown-glow);min-width:300px;
  }
  .crown .t{font-family:var(--display);font-size:1.55rem;font-weight:800;letter-spacing:-.01em}
  .crown .s{opacity:.94;font-size:.84rem;margin-top:2px;font-weight:500}
  .connector{width:2px;height:36px;background:linear-gradient(var(--green),var(--l3))}
  .fan{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;width:100%}
  @media(max-width:780px){.fan{grid-template-columns:repeat(2,1fr)}}
  .domcard{
    border:1px solid var(--line);border-radius:var(--radius);padding:16px;background:var(--panel);box-shadow:var(--shadow);
    border-top:4px solid var(--dc);transition:transform .16s,box-shadow .16s;
  }
  .domcard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
  .domcard .code{font-family:var(--mono);font-size:.72rem;color:#04121c;background:var(--dc);padding:2px 8px;border-radius:4px;font-weight:700;display:inline-block}
  .domcard .nm{font-family:var(--display);font-weight:700;margin:10px 0 4px;font-size:1.0rem;line-height:1.15;color:var(--ink)}
  .domcard .ds{font-size:.82rem;color:var(--muted);line-height:1.4}
  .flow-note{
    margin:26px auto 0;background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--green);border-radius:var(--radius);
    padding:16px 20px;font-size:.95rem;max-width:820px;color:var(--text);
  }
  .flow-note b{color:var(--ink)}

  /* ---------------- grid + cards ---------------- */
  .grid{display:grid;gap:18px}
  .g2{grid-template-columns:repeat(2,1fr)}
  .g3{grid-template-columns:repeat(3,1fr)}
  @media(max-width:820px){.g2,.g3{grid-template-columns:1fr}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
  .card h4{font-family:var(--display);font-weight:700;margin:0 0 7px;font-size:1.05rem;color:var(--ink)}
  .card .tag{font-family:var(--mono);font-size:.72rem;background:var(--teal-soft);color:var(--teal-dim);padding:4px 9px;border-radius:6px;font-weight:600;display:inline-block;margin-bottom:9px}
  .card p{margin:0;font-size:.9rem;color:var(--text)}

  /* ---------------- level legend ---------------- */
  .levels{display:flex;flex-direction:column;gap:9px;margin-top:10px}
  .lvl{display:flex;align-items:center;gap:16px;border:1px solid var(--line);border-radius:var(--radius);padding:12px 16px;background:var(--panel);box-shadow:var(--shadow)}
  .lvl .chip{width:46px;height:46px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--display);font-weight:800;flex-shrink:0;font-size:1rem}
  .lvl .ttl{font-weight:700;color:var(--ink)}
  .lvl .ex{font-family:var(--mono);font-size:.78rem;color:var(--muted);margin-left:auto;text-align:right}

  /* ---------------- explorer ---------------- */
  .explorer{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-lg);overflow:hidden}
  .ex-top{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line);background:var(--bg2)}
  .domtabs{display:flex;gap:7px;flex-wrap:wrap}
  .domtab{border:1px solid var(--line);background:transparent;border-radius:999px;padding:8px 14px;font-weight:700;font-size:.83rem;cursor:pointer;color:var(--text);display:flex;align-items:center;gap:8px;transition:all .15s}
  .domtab .b{width:11px;height:11px;border-radius:3px;background:var(--dc)}
  .domtab[aria-selected="true"]{color:#04121c;background:var(--dc);border-color:var(--dc)}
  .domtab[aria-selected="true"] .b{background:rgba(0,0,0,.35)}
  .ex-search{margin-left:auto;display:flex;gap:8px;align-items:center}
  .ex-search input{border:1px solid var(--line);border-radius:999px;padding:9px 15px;font-size:.88rem;width:240px;font-family:var(--sans);background:var(--input-bg);color:var(--text)}
  .ex-search input::placeholder{color:var(--muted)}
  .ex-search input:focus{outline:2px solid var(--teal-soft);border-color:var(--teal-dim)}
  .ex-btn{border:1px solid var(--line);background:transparent;border-radius:999px;padding:9px 14px;font-size:.8rem;font-weight:600;cursor:pointer;color:var(--text);transition:all .15s}
  .ex-btn:hover{background:var(--red);color:#fff;border-color:var(--red)}
  .ex-body{display:grid;grid-template-columns:1.15fr .85fr;min-height:540px}
  @media(max-width:900px){.ex-body{grid-template-columns:1fr}}
  .treepane{padding:12px 6px 18px 14px;overflow:auto;max-height:660px;border-right:1px solid var(--line)}
  @media(max-width:900px){.treepane{max-height:440px;border-right:none;border-bottom:1px solid var(--line)}}

  .node{margin:1px 0}
  .node-row{display:flex;align-items:center;gap:8px;padding:6px 9px;border-radius:8px;cursor:pointer;border:1px solid transparent}
  .node-row:hover{background:var(--hover-bg)}
  .node-row.sel{background:var(--red-soft);border-color:rgba(226,0,27,.4)}
  .twist{width:16px;height:16px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.7rem;transition:transform .12s;user-select:none}
  .twist.open{transform:rotate(90deg)}
  .twist.leaf{visibility:hidden}
  .lvlbadge{font-family:var(--mono);font-size:.65rem;font-weight:700;color:#04121c;border-radius:4px;padding:2px 5px;flex-shrink:0;min-width:34px;text-align:center}
  .node-id{font-family:var(--mono);font-size:.77rem;color:var(--muted);flex-shrink:0}
  .node-name{font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
  .node-row.raw .node-name{color:var(--muted)}
  .mini{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:2px 7px;border-radius:999px;flex-shrink:0}
  .mini.data{background:var(--chip-bg);color:var(--muted);border:1px solid var(--line)}
  .mini.shared{background:var(--red-soft);color:var(--red-bright);border:1px solid rgba(226,0,27,.4)}
  .children{margin-left:19px;border-left:1px dashed var(--line);padding-left:7px;display:none}
  .children.open{display:block}

  /* detail pane */
  .detail{padding:22px 24px;overflow:auto;max-height:660px}
  @media(max-width:900px){.detail{max-height:none}}
  .detail .empty{color:var(--muted);font-size:.94rem;display:flex;flex-direction:column;gap:10px;height:100%;justify-content:center;align-items:center;text-align:center}
  .d-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .d-id{font-family:var(--mono);font-weight:700;color:#04121c;padding:4px 10px;border-radius:6px}
  .d-name{font-family:var(--display);font-size:1.4rem;font-weight:800;line-height:1.1;margin:10px 0 2px;letter-spacing:-.015em;color:var(--ink)}
  .d-strat{display:inline-block;font-family:var(--mono);font-size:.73rem;background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:3px 9px;font-weight:500;margin-top:7px;color:var(--text)}
  .d-desc{margin:14px 0;color:var(--text);font-size:.96rem}
  .kv{display:grid;grid-template-columns:auto 1fr;gap:7px 18px;margin:12px 0;font-size:.88rem}
  .kv dt{color:var(--muted);font-weight:600}
  .kv dd{margin:0;color:var(--text)}
  .chips{display:flex;flex-wrap:wrap;gap:7px}
  .refchip,.idchip,.stagechip{font-family:var(--mono);font-size:.73rem;border-radius:6px;padding:3px 8px;font-weight:500;cursor:pointer;border:1px solid var(--line);background:var(--panel2);color:var(--teal-dim)}
  .refchip:hover{background:var(--teal-soft);border-color:var(--teal-dim)}
  .idchip{cursor:pointer;background:var(--panel2);color:var(--text)}
  .idchip:hover{background:var(--teal-soft);color:var(--teal-dim)}
  .stagechip{cursor:default;background:var(--chip-bg);color:var(--text)}
  .d-block{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
  .d-block .lbl{font-size:.71rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:700;margin-bottom:7px}
  .formula{font-family:var(--mono);font-size:.82rem;background:var(--code-bg);border:1px solid var(--line);border-radius:8px;padding:11px 13px;white-space:pre-wrap;word-break:break-word;color:var(--text)}
  .breadcrumb{font-size:.78rem;color:var(--muted);margin-bottom:5px;display:flex;flex-wrap:wrap;gap:5px;align-items:center}
  .breadcrumb .idchip{font-size:.7rem;padding:1px 6px}

  /* ---------------- tables ---------------- */
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);background:var(--panel)}
  table{border-collapse:collapse;width:100%;font-size:.88rem;min-width:520px}
  th,td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line-soft);vertical-align:top}
  th{background:var(--panel2);font-size:.71rem;text-transform:uppercase;letter-spacing:.06em;color:var(--ink);position:sticky;top:0;font-weight:700}
  td{color:var(--text)}
  tbody tr:hover{background:var(--hover-bg)}
  td code{background:var(--code-bg);padding:1px 6px;border-radius:4px}

  details.fold{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:0;overflow:hidden}
  details.fold>summary{cursor:pointer;padding:17px 22px;font-weight:700;list-style:none;display:flex;align-items:center;gap:11px;font-family:var(--display);font-size:1.02rem;color:var(--ink)}
  details.fold>summary::-webkit-details-marker{display:none}
  details.fold>summary::before{content:"▸";color:var(--red-bright);transition:transform .16s;font-size:1rem}
  details.fold[open]>summary::before{transform:rotate(90deg)}
  details.fold .inner{padding:0 22px 20px}

  .callout{border-left:4px solid var(--warn);background:var(--warnbg);border-radius:0 var(--radius) var(--radius) 0;padding:15px 19px;margin:18px 0;font-size:.92rem;color:var(--text)}
  .callout b{color:var(--warn)}
  .callout.info{border-color:var(--teal-dim);background:var(--teal-soft)}
  .callout.info b{color:var(--teal-dim)}

  /* steps */
  ol.steps{list-style:none;counter-reset:s;padding:0;margin:18px 0 0;display:grid;gap:13px}
  ol.steps li{counter-increment:s;position:relative;padding:16px 18px 16px 62px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);color:var(--text)}
  ol.steps li::before{content:counter(s);position:absolute;left:15px;top:15px;width:32px;height:32px;border-radius:50%;background:var(--red);color:#fff;font-family:var(--display);font-weight:800;display:flex;align-items:center;justify-content:center;font-size:.95rem}
  ol.steps li b{display:block;margin-bottom:3px;font-size:1rem;color:var(--ink)}
  ol.steps li span{font-size:.9rem;color:var(--text)}

  /* normalization viz */
  .normbox{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:720px){.normbox{grid-template-columns:1fr}}
  .band{border:1px solid var(--line);border-radius:var(--radius);padding:17px;background:var(--panel);box-shadow:var(--shadow)}
  .band h4{font-family:var(--display);font-weight:700;margin:0 0 4px;font-size:1.02rem;color:var(--ink)}
  .gradient{height:18px;border-radius:6px;margin:14px 0 6px}
  .gradient.up{background:linear-gradient(90deg,#e2001b,#e0a21a,#0d9e5a)}
  .gradient.down{background:linear-gradient(90deg,#0d9e5a,#e0a21a,#e2001b)}
  .bandlbl{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);font-family:var(--mono)}

  footer{padding:44px 0 72px;border-top:3px solid var(--red);color:#93a3b1;font-size:.86rem;background:var(--footer-bg)}
  footer .wrap{color:#93a3b1}
  footer b,footer em{color:#fff}

  #toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:#04121c;border:1px solid #243a4d;color:#fff;padding:15px 19px;border-radius:var(--radius);max-width:min(560px,92vw);box-shadow:0 18px 50px rgba(0,0,0,.6);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:100;font-size:.9rem}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}
  #toast .tt{font-family:var(--mono);font-weight:600;color:#7ad3e6;margin-bottom:4px}
  #toast .ty{font-size:.72rem;color:#7f909e;text-transform:uppercase;letter-spacing:.05em;margin-top:7px}
  #toast a{color:#7ad3e6}
</style>
</head>
<body>
<nav>
  <div class="wrap">
    <a class="brand" href="#top" aria-label="GoProZero KPI System — powered by it's OWL">
      <span class="wordmark">GoProZero</span>
      <span class="divider"></span>
      <span class="owl">
        <span class="pb">powered by</span>
        <span class="box">it's owl</span>
      </span>
    </a>
    <span class="links">
      <a href="#picture" data-i18n="nav.big">Big picture</a>
      <a href="#explorer" data-i18n="nav.explorer">Explorer</a>
      <a href="#levels" data-i18n="nav.levels">Levels</a>
      <a href="#aggregation" data-i18n="nav.aggregation">Aggregation</a>
      <a href="#strategies" data-i18n="nav.strategies">Strategies</a>
      <a href="#weights" data-i18n="nav.weights">Weights</a>
