      <span class="code">${d.scoreId}</span>
      <div class="nm">${esc(domName(d))}</div>
      <div class="ds">${esc((DOMAIN_DESC[LANG]||DOMAIN_DESC.en)[d.id]||'')}</div>
    </div>`;
